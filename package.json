{
  "name": "automation-systems-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-neutral automation reference architecture with MCP, HTTP and reproducible n8n examples.",
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file-if-exists=.env src/http.mjs",
    "mcp": "node --env-file-if-exists=.env src/mcp.mjs",
    "demo": "node scripts/demo.mjs",
    "generate": "node scripts/generate.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test test/*.test.mjs",
    "test:n8n": "node scripts/test-n8n.mjs",
    "check": "npm run validate && npm test",
    "deploy": "node --env-file-if-exists=.env scripts/deploy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0"
  }
}
