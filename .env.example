# Run npm run setup to generate local tokens. Never commit your .env.
LAB_PORT=4317
LAB_RUNNER_TOKEN=
LAB_MAINTAINER_TOKEN=
# Optional: MCP bridge uses LAB_TOKEN, or LAB_RUNNER_TOKEN by default.
LAB_URL=http://127.0.0.1:4317
# Optional local n8n installation. No production URL belongs here.
N8N_API_URL=http://127.0.0.1:5678
N8N_API_KEY=
